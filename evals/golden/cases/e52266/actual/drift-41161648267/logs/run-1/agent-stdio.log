  \"bug :beetle:\",\n   \"platform/linux\"\n  ],\n  \"author_association\": \"NONE\",\n  \"opened\": \"2026-07-06T13:58:01Z\"\n },\n \"form_fields\": {\n  \"electron_version\": \"43.0.0\",\n  \"os\": \"Ubuntu\",\n  \"last_known_working\": \"42.6.0\",\n  \"testcase_gist_url\": null\n },\n \"repro\": {\n  \"gist\": false,\n  \"other_repo_link\": false,\n  \"code_blocks\": 0\n },\n \"bot_already\": {\n  \"asked_for_supported_version\": false,\n  \"need_repro_label\": false\n },\n \"issues_linked_by_reporter\": [],\n \"component_hints\": [\n  {\n   \"label\": \"component/printing\",\n   \"matched\": [\n    \"print(\",\n    \"webcontents.print\",\n    \"printer\"\n   ],\n   \"in_title\": true\n  },\n  {\n   \"label\": \"component/webcontents\",\n   \"matched\": [\n    \"webcontents\"\n   ],\n   \"in_title\": true\n  }\n ],\n \"redirect_hints\": {\n  \"upstream\": [\n   \"chromium\"\n  ]\n },\n \"similar_candidates\": [\n  {\n   \"number\": 50785,\n   \"opened\": \"2026-04-07\",\n   \"score\": 44.5,\n   \"title\": \"webContents.print produce tiny print out when silent is true and dpi passed it\",\n   \"shared_terms\": [\n    \"win.webcontents.print\",\n    \"devicename\",\n    \"webcontents.print\",\n    \"silent\",\n    \"print\",\n    \"settings\",\n    \"content\",\n    \"true\"\n   ],\n   \"already_linked_by_reporter\": false,\n   \"excerpt\": \"### Expected Behavior In Electron v41.1.1, when calling webContents.print with silent: true and with paperSize and dpi defined, the printout should respect the specified page size and DPI settings, and scale the content to fit the page. ``` win.webContents.print({ deviceName:\\\"Microsoft Print to PDF\\\", silent: true, margins:{marginType: \\\"default\\\"}, pageSize:\\\"Letter\\\", printBackground:true, color: fal\"\n  },\n  {\n   \"number\": 52048,\n   \"opened\": \"2026-06-17\",\n   \"score\": 42.8,\n   \"title\": \"webContents.print() ignores the `duplexMode` and `printBackground` options (read under the wrong key) since v41.0.0; silent print also never inherits the printer's default duplex\",\n   \"shared_terms\": [\n    \"devicename\",\n    \"webcontents.print\",\n    \"printer\",\n    \"silent\",\n    \"print\",\n    \"settings\",\n    \"options\",\n    \"object\"\n   ],\n   \"already_linked_by_reporter\": false,\n   \"excerpt\": \"### Expected Behavior For `webContents.print()` (silent path): - Passing `duplexMode: 'longEdge' | 'shortEdge' | 'simplex'` should take effect. - Passing `printBackground: true` should print background graphics. - This is how 40.x behaves. - Also, omitting `duplexMode` should letting the printer/driver default duplex apply during silent printing ### Actual Behavior Since 41.0.0, in `webContents.pr\"\n  },\n  {\n   \"number\": 49374,\n   \"opened\": \"2026-01-12\",\n   \"score\": 39.1,\n   \"title\": \"Enable system default page size handling to print method\",\n   \"shared_terms\": [\n    \"devicename\",\n    \"webcontents.print\",\n    \"printer\",\n    \"silent\",\n    \"print\",\n    \"settings\",\n    \"content\",\n    \"true\"\n   ],\n   \"already_linked_by_reporter\": false,\n   \"excerpt\": \"### Problem Description Electron's `webContents.print()` diverges from Chromium's default printing behavior by hard-coding A4 (210mm × 297mm) as the media size when no explicit `pageSize` or `mediaSize` is provided. In contrast, Chromium's `window.print()` queries the printer driver to obtain native defaults. **Impact of this divergence:** 1. **Thermal/Receipt Printers Broken**: POS systems using \"\n  },\n  {\n   \"number\": 50420,\n   \"opened\": \"2026-03-23\",\n   \"score\": 38.3,\n   \"title\": \"Print methods fail on Electron 41 under Linux\",\n   \"shared_terms\": [\n    \"webcontents.print\",\n    \"printer\",\n    \"invalid\",\n    \"print\",\n    \"settings\",\n    \"dialog\",\n    \"linux\"\n   ],\n   \"already_linked_by_reporter\": false,\n   \"excerpt\": \"### Expected Behavior Calling `window.print` from the render process or `webContents.print